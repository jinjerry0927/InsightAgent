# Copy to .env locally. Never commit or share the real key.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Project limits, not NVIDIA account quotas. SDK retries are always disabled.
NVIDIA_TIMEOUT_SECONDS=30
NVIDIA_MAX_TOKENS=1024
